# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Rate sources: the contract and the example are versioned, whatever anyone
# installs here is not. They are separate npm projects, with their own
# node_modules, which is why planfly's package.json does not know they exist.
/providers/*
!/providers/README.md
!/providers/example/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# financial data — none of this leaves the machine
/pgdata
/pgdata.viejo*
/backups
/storage
*.dump
*.sql.gz
*.sqlite
*.sqlite3
# note: drizzle/*.sql is NOT ignored, migrations are source code

# The compose override belongs to each machine: the proxy, the domains and
# whatever only makes sense in your installation go there. The .example is
# versioned.
/compose.override.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent tooling (impeccable and company): ~300 files, 7 MB, and reinstalled
# with `npx impeccable install`. It is not the project's code.
/.claude
/.cursor
# Snapshots from `/impeccable critique`: reports of one particular run against
# one state of the code, not documentation that ages well in the repo.
/.impeccable
