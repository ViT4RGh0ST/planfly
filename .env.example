# Copy to BOTH: .env (read by docker compose) and .env.local (read by the npm
# scripts). Without .env, `docker compose up` errors out before starting
# anything. .env* is in .gitignore except for this example.

# Postgres 18 in Docker (compose.yaml), published on localhost only.
DATABASE_URL="postgresql://planfly:planfly@127.0.0.1:5433/planfly"

# The household's timezone. UTC-4 with no daylight saving: a 21:00 expense
# recorded in UTC would land on the following day.
TZ="America/Caracas"

# better-auth: session signing secret. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Other domains you come in through, comma separated. Only needed if you give it
# a name of its own with a proxy in front: undeclared, the login fails from
# there because better-auth compares the Origin against BETTER_AUTH_URL.
# AUTH_TRUSTED_ORIGINS="http://planfly.mydomain"

# scripts/design-scan.mjs: the password of the user to log in as for scanning
# the screens behind the login. It is your real app password, not a separate
# secret. SCAN_EMAIL is only needed if you are not the owner.
SCAN_PASSWORD=""
# SCAN_EMAIL="you@example.com"

# Seeding and maintenance. They deliberately have no defaults: seeding the
# database with someone else's account is the kind of mistake you don't notice
# until you have already logged in as them.
SEED_EMAIL="you@example.com"
SEED_PASSWORD=""
# SEED_NAME="Your name"        # optional, defaults to "Me"
# SEED_LOCALE=es               # the household's language: en (default) or es.
#                              # It governs the interface AND what the bot
#                              # answers in. Changeable afterwards from the
#                              # navigation, so getting it wrong costs nothing.
# RESET_EMAIL="you@example.com"  # for npm run auth:reset

# Telegram alerts are optional. A bot chat is bound to ONE household, so alerts
# from another household can never appear in that chat. `npm run db:seed` prints
# the household id when it creates one; set it here before enabling alerts.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# TELEGRAM_HOUSEHOLD_ID=""

# Rate sources. See providers/README.md to connect your own.
#
# An empty official slot = the rate is written by hand in /rates.
#
# WATCH OUT for the parallel one: leaving it empty uses a BUILT-IN reader that
# queries Binance's public ads API filtered for Venezuela — on the heartbeat and
# also when recording an expense with no fresh rate for the day. Outside
# Venezuela it will give you nothing representative. To switch it off entirely:
# RATES_PROVIDER_P2P=none
# RATES_PROVIDER_BCV=my-source
# RATES_PROVIDER_P2P=my-other-source
