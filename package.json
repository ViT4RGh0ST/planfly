{
  "name": "planfly",
  "version": "0.1.0",
  "description": "Self-hosted personal finance for economies with two currencies and two exchange rates at once: every entry stores both rates of the day and both equivalents already computed.",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env.local scripts/demo.ts",
    "rates:snapshot": "tsx --env-file-if-exists=.env.local scripts/snapshot-rates.ts",
    "token:create": "tsx --env-file-if-exists=.env.local scripts/create-token.ts",
    "token:revoke": "tsx --env-file-if-exists=.env.local scripts/revoke-token.ts",
    "auth:reset": "tsx --env-file-if-exists=.env.local scripts/reset-password.ts",
    "scan:user": "tsx --env-file-if-exists=.env.local scripts/scan-user.ts",
    "rates:check": "tsx --env-file-if-exists=.env.local scripts/check-rates.ts",
    "openclaw:install": "rsync -a --delete openclaw/planfly-plugin/ ~/.openclaw/extensions/planfly/ && echo \"Installed. Now restart the openclaw gateway so it picks it up.\"",
    "openclaw:capture": "rsync -a --delete ~/.openclaw/extensions/planfly/ openclaw/planfly-plugin/ && echo \"Pulled into the repo. Review the diff before committing.\"",
    "mcp:token": "tsx --env-file-if-exists=.env.local scripts/create-token.ts mcp 'mcp:access,context:read,reports:read,transactions:write'"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/leaflet": "^1.9.22",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.7",
    "nuqs": "^2.9.5",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
